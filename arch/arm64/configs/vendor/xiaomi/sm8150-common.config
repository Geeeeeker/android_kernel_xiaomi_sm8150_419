# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# exFAT
CONFIG_EXFAT_FS=y

# EROFS
CONFIG_EROFS_FS=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=n

# pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Backlight
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=n

# Camera motor
CONFIG_TI_DRV8846=n

# Fingerprint
CONFIG_INPUT_FINGERPRINT=n
CONFIG_FINGERPRINT_FPC_TEE=n
CONFIG_FINGERPRINT_GOODIX_TA=n

# Haptics
CONFIG_INPUT_AW8697_XM_HAPTIC=n

# IR
CONFIG_IR_SPI=n
CONFIG_LIRC=n
CONFIG_RC_CORE=n
CONFIG_RC_DECODERS=n
CONFIG_MEDIA_RC_SUPPORT=n
CONFIG_RC_DEVICES=n

# Keyboard
CONFIG_XIAOMI_KEYBOARD=n

# Power
# CONFIG_SMB1355_SLAVE_CHARGER is not set
CONFIG_SMB1390_CHARGE_PUMP_PSY=n
CONFIG_SMB1390_CHARGE_PUMP=n
CONFIG_FRAME_WARN=4096

# Proximity
CONFIG_US_PROXIMITY=n

# Sensors
CONFIG_AKM09970=n

# Simtray
CONFIG_SIMTRAY_STATUS=n

# spk-id
CONFIG_HAS_IOMEM=n
CONFIG_MFD_SPK_ID=n

# TEE
CONFIG_TRUSTY=n

# Touchscreen
# CONFIG_TOUCHSCREEN_ST is not set
CONFIG_TOUCHSCREEN_COMMON=n
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=n

# debugfs disable
CONFIG_MSM_IDLE_STATS=n
CONFIG_PAGE_EXTENSION=n
CONFIG_PAGE_OWNER=n
CONFIG_DEBUG_FS=n
